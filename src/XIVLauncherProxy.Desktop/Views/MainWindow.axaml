<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XIVLauncherProxy.Desktop.ViewModels" xmlns:config="using:XIVLauncherProxy.Domain.Configuration" xmlns:l10n="using:XIVLauncherProxy.Desktop.Localization"
        x:Class="XIVLauncherProxy.Desktop.Views.MainWindow" x:DataType="vm:MainViewModel"
        Width="1040" Height="700" MinWidth="920" MinHeight="620" Title="{l10n:Tr AppTitle}"
        Icon="/Assets/app.ico" Background="#F3F6F9" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="104,*">
    <Border Background="White" BorderBrush="#3979B9" BorderThickness="0,0,0,4">
      <Grid Margin="28,0" ColumnDefinitions="Auto,*,Auto">
        <Image Source="/Assets/app.ico" Width="54" Height="54" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="{l10n:Tr AppTitle}" FontSize="22" FontWeight="Bold" Foreground="#263445"/>
          <TextBlock Text="{l10n:Tr AppTagline}" Foreground="#667487"/>
        </StackPanel>
        <ProgressBar Grid.Column="2" Width="90" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="210,*">
      <Border Background="#F8FAFC" BorderBrush="#D8E0E9" BorderThickness="0,0,1,0">
        <Grid Margin="14" RowDefinitions="Auto,*,Auto">
          <StackPanel>
            <Button Classes="nav" Classes.active="{Binding IsGeneralPage}" Content="{l10n:Tr General}" Command="{Binding ShowGeneralCommand}"/>
            <Button Classes="nav" Classes.active="{Binding IsProfilesPage}" Content="{l10n:Tr Profiles}" Command="{Binding ShowProfilesCommand}"/>
          </StackPanel>
          <Border Grid.Row="2" Classes="card" Padding="14">
            <StackPanel Spacing="6">
              <TextBlock Text="{l10n:Tr CurrentStatus}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding StatusMessage}" Classes="hint" TextWrapping="Wrap" MaxLines="5"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Border Padding="28,18" Background="White" BorderBrush="#D8E0E9" BorderThickness="0,0,0,1">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding PageTitle}" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding PageSubtitle}" Classes="hint"/>
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsGeneralPage}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="28" Spacing="18">
            <Border Classes="card">
              <StackPanel Spacing="13">
                <TextBlock Text="{l10n:Tr Launcher}" Classes="section"/>
                <TextBlock Text="{l10n:Tr LauncherHint}" Classes="hint"/>
                <TextBlock Text="{l10n:Tr LauncherPath}" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding LauncherPath}"/>
                  <Button Grid.Column="1" Content="{l10n:Tr Browse}" Command="{Binding BrowseLauncherCommand}"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="13">
                <TextBlock Text="{l10n:Tr ProxySettings}" Classes="section"/>
                <TextBlock Text="{l10n:Tr ProxyHint}" Classes="hint"/>
                <TextBlock Text="{l10n:Tr ProxyAddress}" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding ProxyAddress}" PlaceholderText="http://127.0.0.1:37777"/>
                  <Button Grid.Column="1" Content="{l10n:Tr TestConnection}" Command="{Binding TestProxyCommand}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="24">
                  <CheckBox Content="{l10n:Tr SetAllProxy}" IsChecked="{Binding SetAllProxy}"/>
                  <CheckBox Content="{l10n:Tr BypassLocal}" IsChecked="{Binding BypassLocalAddresses}"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Button Classes="primary" HorizontalAlignment="Right" Content="{l10n:Tr SaveGeneral}" Command="{Binding SaveGeneralCommand}"/>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="28" ColumnDefinitions="240,*" ColumnSpacing="18" IsVisible="{Binding IsProfilesPage}">
          <Border Classes="card" Padding="14">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Text="{l10n:Tr ProfileListHint}" Classes="hint" TextWrapping="Wrap" Margin="4,2,4,12"/>
              <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                <ListBox.ItemTemplate><DataTemplate x:DataType="config:LaunchProfile"><TextBlock Text="{Binding Name}" Padding="6"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,12,0,0">
                <Button Content="{l10n:Tr Add}" Command="{Binding AddProfileCommand}"/>
                <Button Grid.Column="1" Content="{l10n:Tr Delete}" Command="{Binding DeleteProfileCommand}"/>
              </Grid>
            </Grid>
          </Border>

          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <Border Classes="card" IsEnabled="{Binding HasSelectedProfile}">
              <StackPanel Spacing="12">
                <TextBlock Text="{l10n:Tr ProfileName}" FontWeight="SemiBold"/>
                <TextBox Text="{Binding ProfileName}"/>
                <StackPanel Orientation="Horizontal" Spacing="24">
                  <CheckBox Content="{l10n:Tr UseProxy}" IsChecked="{Binding UseProxy}"/>
                  <CheckBox Content="{l10n:Tr UseQuickLogin}" IsChecked="{Binding UseQuickLogin}"/>
                </StackPanel>
                <TextBlock Text="{l10n:Tr Account}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" IsEnabled="{Binding UseQuickLogin}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AccountOption"><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Content="{l10n:Tr RefreshAccounts}" Command="{Binding ReloadAccountsCommand}"/>
                </Grid>
                <TextBlock Text="{l10n:Tr TotpSecret}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding TotpSecret}" PasswordChar="●" IsEnabled="{Binding UseQuickLogin}" PlaceholderText="{l10n:Tr TotpHint}"/>
                  <Button Grid.Column="1" Content="{l10n:Tr ClearSecret}" Command="{Binding ClearSecretCommand}"/>
                </Grid>
                <TextBlock Text="{Binding CredentialStatus}" Classes="hint" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                  <Button Content="{l10n:Tr SaveProfile}" Command="{Binding SaveProfileCommand}"/>
                  <Button Classes="primary" Content="{l10n:Tr CreateShortcut}" Command="{Binding CreateShortcutCommand}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
